# Cloudflare CLI credentials for your own Cloudflare account.
# Fill in these values locally. Do not commit or paste the token into chat.
# Do not use NEXT_PUBLIC_ or VITE_ prefixes for these credentials.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The current live Site uses managed DB and BUCKET bindings.
# Adding these credentials does not migrate the live Site to your account.

# Owner login for the standalone Cloudflare Worker (keep the password private).
POS_ADMIN_USER=admin
POS_ADMIN_PASSWORD=
# Optional URL used by private deployment checks.
CLOUDFLARE_WORKER_URL=

# Optional Resend key for daily close reports.
RESEND_API_KEY=
